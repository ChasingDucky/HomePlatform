# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://homeplatform:homeplatform_dev@localhost:5432/homeplatform?schema=public"
TIMESCALEDB_URL="postgresql://homeplatform:homeplatform_dev@localhost:5433/homeplatform_timeseries?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# RabbitMQ
RABBITMQ_URL=amqp://homeplatform:homeplatform_dev@localhost:5672

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=homeplatform
MINIO_SECRET_KEY=homeplatform_dev
MINIO_BUCKET=homeplatform

# WebSocket
WS_PORT=3001

# Matter / IoT
MATTER_PORT=5540
MATTER_PASSCODE=20202021
MATTER_DISCRIMINATOR=3840

# Logging
LOG_LEVEL=debug
